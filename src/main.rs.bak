use iced::widget::{button, column, text};
use iced::{Alignment, Element, Length};

fn main() -> iced::Result {
    // iced 0.13: title, update fn, view fn
    iced::run("Hello, Iced!", App::update, App::view)
}

#[derive(Default)]
struct App {
    clicks: u32,
}

#[derive(Debug, Clone)]
enum Message {
    Clicked,
    Reset,
}

impl App {
    fn update(&mut self, message: Message) {
        match message {
            Message::Clicked => self.clicks += 1,
            Message::Reset => self.clicks = 0,
        }
    }

    fn view(&self) -> Element<'_, Message> {
        column![
            text("Hello, world!").size(40),
            text(format!("Button clicked {} times", self.clicks)),
            button("Click me").on_press(Message::Clicked),
            button("Reset").on_press(Message::Reset),
        ]
        .spacing(12)
        .padding(20)
        .width(Length::Fill)
        .align_x(Alignment::Center)
        .into()
    }
}
